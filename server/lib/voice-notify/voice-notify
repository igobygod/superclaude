#!/usr/bin/env python3
"""voice-notify --level info|important|urgent --text T [--question-id Q]
info = one iMessage (Telegram if the Mac can't be reached). important = iMessage, then a phone-call request if still
unanswered after ~10 min. urgent = call now + iMessage. Calls respect quiet hours (23-7 local time, AGENT_TZ) unless urgent, and daily caps."""
import argparse, sys, time
sys.path.insert(0, "/usr/local/lib/voice-notify")
import vn_common as v

ap = argparse.ArgumentParser(prog="voice-notify")
ap.add_argument("--level", required=True, choices=["info", "important", "urgent"])
ap.add_argument("--text", required=True)
ap.add_argument("--question-id")
ap.add_argument("--no-wait", action="store_true")
x = ap.parse_args()
c = v.db()
if x.question_id and not c.execute("select 1 from questions where id=?", (x.question_id,)).fetchone():
    print("unknown question id", file=sys.stderr); sys.exit(4)
nid = v.new_id("n")
c.execute("insert into notifs(id,level,text,question_id,created) values(?,?,?,?,?)", (nid, x.level, x.text[:1500], x.question_id, time.time()))
if x.no_wait:
    print(nid + " queued"); sys.exit(0)
for _ in range(25):
    time.sleep(1)
    r = c.execute("select status,detail from notifs where id=?", (nid,)).fetchone()
    if r["status"] != "queued":
        if r["status"] != "sending":
            print(f"{nid} {r['status']} {r['detail'] or ''}".strip()); sys.exit(0)
print(nid + " queued (sending in the background)")
