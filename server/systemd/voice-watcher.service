[Unit]
Description=Voice caller watcher (calendar, urgent email, snoozes)
After=voice-caller.service

[Service]
EnvironmentFile=-/etc/voice-caller/agent.env
User=voicecaller
WorkingDirectory=/srv/voice-caller
EnvironmentFile=/etc/voice-caller/livekit.env
EnvironmentFile=/etc/voice-caller/secrets.env
ExecStart=/srv/voice-caller/venv/bin/python watcher.py
Restart=always
RestartSec=15
MemoryMax=400M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/voicecaller /var/lib/voice-tasks
SupplementaryGroups=voicetasks
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
