# Mac side. imessage-agent runs under launchd: put these in the LaunchAgent plist's
# EnvironmentVariables. voice-journal-hook runs from Claude Code hooks: export them in your shell profile.
OWNER_HANDLES=+15555550100,owner@example.com   # your own iMessage handles (the only thread the listener reads)
SUPERCLAUDE_SERVER=203.0.113.10                # server address (its Tailscale IP works too)
SERVER_USER=claude-helper
IMSG_SSH_KEY=$HOME/.ssh/superclaude-imsg       # restricted key: forwards messages only
JOURNAL_SSH_KEY=$HOME/.ssh/voice-journal       # restricted key: journals Mac Claude sessions
PUBLIC_HOST=voice.example.com                  # heartbeat URL host
