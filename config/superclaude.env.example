# SuperClaude settings. Placeholders only: copy, fill in, and NEVER commit the filled copy.
# On the server this splits into three root-only files (chmod 640, root:voicecaller):
#   /etc/voice-caller/agent.env    plain settings (section A)
#   /etc/voice-caller/secrets.env  keys and passwords (section B)
#   /etc/voice-caller/livekit.env  LiveKit API pair (section C, same pair as livekit.yaml / sip.yaml)

########## A. /etc/voice-caller/agent.env  (not secret) ##########
OWNER_NAME="Jordan Lee"                 # your name, used to sign drafted emails
OWNER_EMAIL=owner@example.com           # your Gmail/Calendar address
OWNER_PHONE=+15555550100                # your iPhone number (iMessage)
OWNER_HANDLES=+15555550100,owner@example.com   # iMessage handles accepted as "you"
OWNER_LANGUAGES=                        # optional extra spoken languages, e.g. "Spanish or French"
AGENT_TZ=America/New_York               # your IANA time zone (default UTC). Also: timedatectl set-timezone <Zone>
PUBLIC_HOST=voice.example.com           # HTTPS host for /ask/, /jobs/, /call/ (any DNS name pointing at the server)
QUIET_HOURS=23-7                        # no non-urgent calls in this window; "off" disables
WAKE_MAC=you@192.168.1.50               # Mac login@LAN IP used to wake/SSH the Mac
MAC_USER=you
MAC_LAN_IP=192.168.1.50
# Optional helpers
EXTRA_YES_WORDS=                        # go-ahead words in your other languages for send confirmations, e.g. "si,claro"
EMAIL_QUEUE=/var/lib/voice-email/kept-for-caller.jsonl   # where your own mail sorter drops emails worth a call (sorter not included)
JOB_SEARCH_DIR=                         # folder ON THE MAC with your job-search files; empty = job helpers off
CREATOR_CHANNELS=                       # label=YouTubeChannelId,label2=... ; empty = creator monitor off

# Voice tuning (these are the values the original build settled on; put them in
# /etc/systemd/system/voice-caller.service.d/model.conf as Environment= lines)
GEMINI_LIVE_MODEL=gemini-3.8-live       # code default is an older, slower model: keep this set
GEMINI_VOICE=Puck
SILENCE_MS=300
SPEED_UP=off                            # must stay off (see troubleshooting)
# Code defaults (override only if needed): END_SENSITIVITY=HIGH START_SENSITIVITY=LOW PREFIX_MS=200
# VOICE_LANGUAGE=en-US DENOISE=on THINKING_SOUND=on THINKING_VOLUME=0.35 SOUND_START_AFTER=1.0
# IDLE_ASK_SECONDS=240 IDLE_HANGUP_SECONDS=45 INBOUND_MAX_MINUTES=30 RING_SECONDS=40 ASK_WAIT=25
# VISION_MODEL=gemini-3.8-flash

########## B. /etc/voice-caller/secrets.env  (SECRET) ##########
LINPHONE_PHONE_USER=your-phone-sip-user        # the Linphone account signed in on your iPhone
LINPHONE_SERVER_USER=your-server-sip-user      # second Linphone account used by the server
LINPHONE_SERVER_PASS=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME                       # Google AI Studio key
CALENDAR_ICS_URL=CHANGE_ME                     # private iCal URL of your calendar (for pre-event calls)
TELEGRAM_BOT_TOKEN=CHANGE_ME                   # from BotFather
TELEGRAM_CHAT_ID=CHANGE_ME                     # your chat with the bot
CALL_TOKEN=CHANGE_ME_RANDOM                    # secret path part for /call/<CALL_TOKEN>  (openssl rand -hex 16)
DASH_TOKEN=CHANGE_ME_RANDOM                    # secret path part for /jobs/<DASH_TOKEN>/
SERVER_PUBLIC_IP=203.0.113.10                  # used by the Kamailio relay
SERVER_PRIVATE_IP=10.0.0.10                    # cloud-internal IP (defaults to the public one)
# ANTHROPIC_API_KEY=                           # optional: the watcher uses it for Haiku email triage (Anthropic API, billed per use). Claude Code workers strip it and use the Claude Code login instead.

########## C. /etc/voice-caller/livekit.env  (SECRET) ##########
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
